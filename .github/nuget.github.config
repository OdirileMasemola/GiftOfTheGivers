<?xml version="1.0" encoding="utf-8"?>
<!-- Used only by the GitHub Actions deploy workflow. GitHub cannot sign in to the
     private Azure Artifacts feed, so it restores GiftOfTheGivers.Helpers from the
     copies kept in local-packages. Azure Pipelines and local builds use nuget.config. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="local-packages" value="../local-packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local-packages">
      <package pattern="GiftOfTheGivers.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

@page "/Dashboards/Volunteers"
@model GiftOfTheGivers.Pages.Dashboards.VolunteersModel
@{
    ViewData["Title"] = "Volunteers - Gift of the Givers";
}

<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="dashboard-wrapper">
    <partial name="Shared/_DashboardSidebar" />

    <div class="dashboard-main">

        <div class="dashboard-header">
            <h1 class="dashboard-header-title">Volunteers</h1>
            <p class="dashboard-header-subtitle">
                Manage volunteer applications and assignments
            </p>
        </div>

        <div class="dashboard-content">

            @if (TempData["VolunteersMessage"] != null)
            {
            <div class="alert alert-success">
                @TempData["VolunteersMessage"]
            </div>
            }

            @if (TempData["VolunteersError"] != null)
            {
            <div class="alert alert-danger">
                @TempData["VolunteersError"]
            </div>
            }

            <!-- Statistics -->
            <div class="stats-grid">

                <div class="stat-card">
                    <span class="stat-label">Pending</span>
                    <span class="stat-value">@Model.PendingCount</span>
                    <span class="stat-meta">Applications</span>
                </div>

                <div class="stat-card">
                    <span class="stat-label">Approved</span>
                    <span class="stat-value">@Model.ApprovedCount</span>
                    <span class="stat-meta">Verified volunteers</span>
                </div>

                <div class="stat-card">
                    <span class="stat-label">Active</span>
                    <span class="stat-value">@Model.ActiveCount</span>
                    <span class="stat-meta">Currently serving</span>
                </div>

                <div class="stat-card">
                    <span class="stat-label">Rejected</span>
                    <span class="stat-value">@Model.RejectedCount</span>
                    <span class="stat-meta">Not accepted</span>
                </div>

            </div>

            <!-- Search and Filter -->
            <form method="get" class="volunteer-filters">

                <div class="filter-group">
                    <label for="Search">Search volunteers</label>

                    <input type="text"
                           id="Search"
                           name="Search"
                           value="@Model.Search"
                           placeholder="Search name, email or skills..."
                           class="form-control" />
                </div>

                <div class="filter-group">
                    <label for="StatusFilter">Status</label>

                    <select id="StatusFilter"
                            name="StatusFilter"
                            class="form-control">

                        <option value="All"
                                selected="@(Model.StatusFilter == "All")">
                            All
                        </option>

                        <option value="Pending"
                                selected="@(Model.StatusFilter == "Pending")">
                            Pending
                        </option>

                        <option value="Approved"
                                selected="@(Model.StatusFilter == "Approved")">
                            Approved
                        </option>

                        <option value="Active"
                                selected="@(Model.StatusFilter == "Active")">
                            Active
                        </option>

                        <option value="Rejected"
                                selected="@(Model.StatusFilter == "Rejected")">
                            Rejected
                        </option>

                    </select>
                </div>

                <div class="filter-actions">

                    <button type="submit"
                            class="btn btn-primary">
                        Search
                    </button>

                    <a asp-page="/Dashboards/Volunteers"
                       class="btn btn-secondary">
                        Clear
                    </a>

                </div>

            </form>

            <!-- Volunteer List -->
            <div class="dashboard-section">

                <h2 class="dashboard-section-title">
                    Volunteer list
                </h2>

                <div class="dashboard-table">

                    <div class="dashboard-table-wrapper">

                        @if (Model.Volunteers.Count == 0)
                        {
                        <div class="empty-state">

                            <p class="empty-state-title">
                                No volunteers yet
                            </p>

                            <p class="empty-state-text">
                                Volunteers will appear here after they register.
                            </p>

                        </div>
                        }
                        else
                        {
                        <table>

                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Skills</th>
                                    <th>Availability</th>
                                    <th>Status</th>
                                    <th>Registration Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var volunteer in Model.Volunteers)
                                    {
                                        var volunteerName =
                                            volunteer.User != null
                                                ? $"{volunteer.User.FirstName} {volunteer.User.LastName}"
                                                : "Unknown";

                                        var volunteerEmail =
                                            volunteer.User?.Email ?? "N/A";

                                <tr>

                                    <!-- Name -->
                                    <td>
                                        <strong>
                                            @volunteerName
                                        </strong>
                                    </td>

                                    <!-- Email -->
                                    <td>

                                        @if (!string.IsNullOrEmpty(volunteerEmail)
                                                    && volunteerEmail != "N/A")
                                                {
                                        <a href="mailto:@volunteerEmail">
                                            @volunteerEmail
                                        </a>
                                                }
                                                else
                                                {
                                        <span>N/A</span>
                                                }

                                    </td>

                                    <!-- Skills -->
                                    <td title="@volunteer.Skills">

                                        @{
                                                    var skills =
                                                        volunteer.Skills
                                                        ?? "No skills listed";

                                                    var displaySkills =
                                                        skills.Length > 40
                                                            ? skills.Substring(0, 40) + "..."
                                                            : skills;
                                        }

                                        @displaySkills

                                    </td>

                                    <!-- Availability -->
                                    <td>
                                        @(string.IsNullOrWhiteSpace(
                                                    volunteer.Availability)
                                                    ? "Not specified"
                                                    : volunteer.Availability)
                                    </td>

                                    <!-- Status -->
                                    <td>

                                        <span class="status-badge @volunteer.Status.ToLower()">
                                            @volunteer.Status
                                        </span>

                                    </td>

                                    <!-- Registration Date -->
                                    <td>
                                        @volunteer.RegistrationDate.ToString("dd MMM yyyy")
                                    </td>

                                    <!-- Actions -->
                                    <td>

                                        <div class="action-buttons">

                                            <!-- Details -->
                                            <a asp-page="/Dashboards/VolunteerDetails"
                                               asp-route-id="@volunteer.VolunteerId"
                                               class="btn btn-sm btn-secondary">
                                                Details
                                            </a>

                                            <!-- Pending Actions -->
                                            @if (volunteer.Status == "Pending")
                                                    {
                                                        <!-- Approve -->
                                            <form method="post"
                                                  style="display: inline;">

                                                <input type="hidden"
                                                       name="id"
                                                       value="@volunteer.VolunteerId" />

                                                <input type="hidden"
                                                       name="status"
                                                       value="Approved" />

                                                <input type="hidden"
                                                       name="Search"
                                                       value="@Model.Search" />

                                                <input type="hidden"
                                                       name="StatusFilter"
                                                       value="@Model.StatusFilter" />

                                                <button type="submit"
                                                        asp-page-handler="UpdateStatus"
                                                        class="btn btn-sm btn-success">
                                                    Approve
                                                </button>

                                            </form>

 <!-- Reject -->
                                            <form method="post"
                                                  style="display: inline;">

                                                <input type="hidden"
                                                       name="id"
                                                       value="@volunteer.VolunteerId" />

                                                <input type="hidden"
                                                       name="status"
                                                       value="Rejected" />

                                                <input type="hidden"
                                                       name="Search"
                                                       value="@Model.Search" />

                                                <input type="hidden"
                                                       name="StatusFilter"
                                                       value="@Model.StatusFilter" />

                                                <button type="submit"
                                                        asp-page-handler="UpdateStatus"
                                                        class="btn btn-sm btn-danger">
                                                    Reject
                                                </button>

                                            </form>
                                                    }

                                            <!-- Approved Action -->
                                            @if (volunteer.Status == "Approved")
                                                    {
                                            <form method="post"
                                                  style="display: inline;">

                                                <input type="hidden"
                                                       name="id"
                                                       value="@volunteer.VolunteerId" />

                                                <input type="hidden"
                                                       name="status"
                                                       value="Active" />

                                                <input type="hidden"
                                                       name="Search"
                                                       value="@Model.Search" />

                                                <input type="hidden"
                                                       name="StatusFilter"
                                                       value="@Model.StatusFilter" />

                                                <button type="submit"
                                                        asp-page-handler="UpdateStatus"
                                                        class="btn btn-sm btn-primary">
                                                    Activate
                                                </button>

                                            </form>
                                                    }

                                            <!-- Active Action -->
                                            @if (volunteer.Status == "Active")
                                                    {
                                            <form method="post"
                                                  style="display: inline;">

                                                <input type="hidden"
                                                       name="id"
                                                       value="@volunteer.VolunteerId" />

                                                <input type="hidden"
                                                       name="status"
                                                       value="Pending" />

                                                <input type="hidden"
                                                       name="Search"
                                                       value="@Model.Search" />

                                                <input type="hidden"
                                                       name="StatusFilter"
                                                       value="@Model.StatusFilter" />

                                                <button type="submit"
                                                        asp-page-handler="UpdateStatus"
                                                        class="btn btn-sm btn-secondary">
                                                    Deactivate
                                                </button>

                                            </form>
                                                    }

                                        </div>

                                    </td>

                                </tr>
                                    }

                            </tbody>

                        </table>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
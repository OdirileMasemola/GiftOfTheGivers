@page "/Dashboards/Volunteers"
@model GiftOfTheGivers.Pages.Dashboards.VolunteersModel
@{
    ViewData["Title"] = "Volunteers - Gift of the Givers";
}

<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="dashboard-wrapper">
    <partial name="Shared/_DashboardSidebar" />

    <div class="dashboard-main">
        <div class="dashboard-header">
            <h1 class="dashboard-header-title">Volunteers</h1>
            <p class="dashboard-header-subtitle">Manage volunteer applications and assignments</p>
        </div>

        <div class="dashboard-content">
            <div class="stats-grid">
                <div class="stat-card">
                    <span class="stat-label">Pending</span>
                    <span class="stat-value">@Model.PendingCount</span>
                    <span class="stat-meta">Applications</span>
                </div>
                <div class="stat-card">
                    <span class="stat-label">Approved</span>
                    <span class="stat-value">@Model.ApprovedCount</span>
                    <span class="stat-meta">Verified volunteers</span>
                </div>
                <div class="stat-card">
                    <span class="stat-label">Active</span>
                    <span class="stat-value">@Model.ActiveCount</span>
                    <span class="stat-meta">Currently serving</span>
                </div>
                <div class="stat-card">
                    <span class="stat-label">Rejected</span>
                    <span class="stat-value">@Model.RejectedCount</span>
                    <span class="stat-meta">Not accepted</span>
                </div>
            </div>

            <div class="dashboard-section">
                <h2 class="dashboard-section-title">Volunteer list</h2>
                <div class="dashboard-table">
                    <div class="dashboard-table-wrapper">
                        @if (Model.Volunteers.Count == 0)
                        {
                            <div class="empty-state">
                                <p class="empty-state-title">No volunteers yet</p>
                                <p class="empty-state-text">Volunteers will appear here after they register.</p>
                            </div>
                        }
                        else
                        {
                            <table>
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Skills</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var volunteer in Model.Volunteers)
                                    {
                                        var volunteerName = volunteer.User != null ? $"{volunteer.User.FirstName} {volunteer.User.LastName}" : "Unknown";
                                        var volunteerEmail = volunteer.User?.Email ?? "N/A";
                                        <tr>
                                            <td>
                                                <strong>@volunteerName</strong>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(volunteerEmail) && volunteerEmail != "N/A")
                                                {
                                                    <a href="mailto:@volunteerEmail">@volunteerEmail</a>
                                                }
                                                else
                                                {
                                                    <span>N/A</span>
                                                }
                                            </td>
                                            <td>@(volunteer.Skills ?? "No skills listed")</td>
                                            <td>
                                                <span class="status-badge @volunteer.Status.ToLower()">@volunteer.Status</span>
                                            </td>
                                            <td>
                                                <div class="action-buttons">
                                                    @if (volunteer.Status == "Pending")
                                                    {
                                                        <form method="post" style="display: inline;">
                                                            <input type="hidden" name="id" value="@volunteer.VolunteerId" />
                                                            <input type="hidden" name="status" value="Approved" />
                                                            <button type="submit" asp-page-handler="UpdateStatus" class="btn btn-sm btn-success">Approve</button>
                                                        </form>
                                                        <form method="post" style="display: inline;">
                                                            <input type="hidden" name="id" value="@volunteer.VolunteerId" />
                                                            <input type="hidden" name="status" value="Rejected" />
                                                            <button type="submit" asp-page-handler="UpdateStatus" class="btn btn-sm btn-danger">Reject</button>
                                                        </form>
                                                    }
                                                    @if (volunteer.Status == "Approved")
                                                    {
                                                        <form method="post" style="display: inline;">
                                                            <input type="hidden" name="id" value="@volunteer.VolunteerId" />
                                                            <input type="hidden" name="status" value="Active" />
                                                            <button type="submit" asp-page-handler="UpdateStatus" class="btn btn-sm btn-primary">Activate</button>
                                                        </form>
                                                    }
                                                    @if (volunteer.Status == "Active")
                                                    {
                                                        <form method="post" style="display: inline;">
                                                            <input type="hidden" name="id" value="@volunteer.VolunteerId" />
                                                            <input type="hidden" name="status" value="Pending" />
                                                            <button type="submit" asp-page-handler="UpdateStatus" class="btn btn-sm btn-secondary">Deactivate</button>
                                                        </form>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

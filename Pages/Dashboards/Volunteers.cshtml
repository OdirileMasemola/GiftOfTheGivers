@page "/Dashboards/Volunteers"
@model GiftOfTheGivers.Pages.Dashboards.VolunteersModel
@{
    ViewData["Title"] = "Volunteers - Gift of the Givers";
}

<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="dashboard-wrapper">
    <partial name="Shared/_DashboardSidebar" />

    <div class="dashboard-main">
        <div class="dashboard-header">
            <h1 class="dashboard-header-title">Volunteers</h1>
            <p class="dashboard-header-subtitle">Review volunteer registrations and availability</p>
        </div>

        <div class="dashboard-content">
            <div class="dashboard-placeholder">
                <div class="dashboard-placeholder-icon">
                    <i class="bi bi-people" aria-hidden="true"></i>
                </div>
                <h2>Volunteer review</h2>
                <p>This page is ready for volunteer approvals. Use Overview for recent sign-ups.</p>
                <a href="/Dashboards/Employee" class="btn btn-primary">Back to overview</a>
            </div>
        </div>
    </div>
</div>

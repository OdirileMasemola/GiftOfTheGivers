@page "/Dashboards/Donations"
@model GiftOfTheGivers.Pages.Dashboards.DonationsModel
@{
    ViewData["Title"] = "Donations - Gift of the Givers";
}

<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="dashboard-wrapper">
    <partial name="Shared/_DashboardSidebar" />

    <div class="dashboard-main">
        <div class="dashboard-header">
            <h1 class="dashboard-header-title">Donations</h1>
            <p class="dashboard-header-subtitle">Monitor incoming support for relief work</p>
        </div>

        <div class="dashboard-content">
            <div class="stats-grid">
                <div class="stat-card">
                    <span class="stat-label">This month</span>
                    <span class="stat-value">ZAR @Model.ThisMonthZar.ToString("N0")</span>
                    <span class="stat-meta">ZAR received</span>
                </div>
                <div class="stat-card">
                    <span class="stat-label">All time</span>
                    <span class="stat-value">ZAR @Model.AllTimeZar.ToString("N0")</span>
                    <span class="stat-meta">ZAR received</span>
                </div>
                <div class="stat-card">
                    <span class="stat-label">Gifts</span>
                    <span class="stat-value">@Model.Donations.Count</span>
                    <span class="stat-meta">Recorded donations</span>
                </div>
                <div class="stat-card">
                    <span class="stat-label">Active Schedules</span>
                    <span class="stat-value">@Model.RecurringCount</span>
                    <span class="stat-meta">Recurring donations</span>
                </div>
            </div>

            <div class="dashboard-section">
                <h2 class="dashboard-section-title">All donations</h2>
                <div class="dashboard-table">
                    <div class="dashboard-table-wrapper">
                        @if (Model.Donations.Count == 0)
                        {
                            <div class="empty-state">
                                <p class="empty-state-title">No donations yet</p>
                                <p class="empty-state-text">Gifts from the public Donate page will show up here.</p>
                            </div>
                        }
                        else
                        {
                            <table>
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Donor</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                        <th>Reference</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var donation in Model.Donations)
                                    {
                                        var donorName = donation.User != null ? $"{donation.User.FirstName} {donation.User.LastName}" : "Anonymous";
                                        var donorEmail = donation.User?.Email ?? "";
                                        <tr>
                                            <td>@donation.DonationDate.ToString("d MMM yyyy")</td>
                                            <td>
                                                <strong>@donorName</strong>
                                                <div class="table-muted">
                                                    @if (!string.IsNullOrEmpty(donorEmail))
                                                    {
                                                        <a href="mailto:@donorEmail">@donorEmail</a>
                                                    }
                                                    else
                                                    {
                                                        <span>Anonymous</span>
                                                    }
                                                </div>
                                            </td>
                                            <td>@donation.Currency @donation.Amount.ToString("N0")</td>
                                            <td>
                                                <span class="status-badge @(donation.PaymentStatus == "Completed" ? "completed" : "pending")">
                                                    @donation.PaymentStatus
                                                </span>
                                            </td>
                                            <td><span class="mono-ref">@(donation.PaymentReference ?? "N/A")</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

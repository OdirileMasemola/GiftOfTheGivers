@page "/Dashboards/Donations"
@model GiftOfTheGivers.Pages.Dashboards.DonationsModel
@{
    ViewData["Title"] = "Donations - Gift of the Givers";
}

<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="dashboard-wrapper">
    <partial name="Shared/_DashboardSidebar" />

    <div class="dashboard-main">
        <div class="dashboard-header">
            <h1 class="dashboard-header-title">Donations</h1>
            <p class="dashboard-header-subtitle">Monitor incoming support for relief work</p>
        </div>

        <div class="dashboard-content">
            <div class="dashboard-placeholder">
                <div class="dashboard-placeholder-icon">
                    <i class="bi bi-cash-stack" aria-hidden="true"></i>
                </div>
                <h2>Donation tracking</h2>
                <p>This page is ready for donation records. Use Overview for current totals.</p>
                <a href="/Dashboards/Employee" class="btn btn-primary">Back to overview</a>
            </div>
        </div>
    </div>
</div>

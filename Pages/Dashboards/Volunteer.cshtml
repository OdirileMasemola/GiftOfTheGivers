@page "/Dashboards/Volunteer"
@model GiftOfTheGivers.Pages.Dashboards.VolunteerModel
@{
    ViewData["Title"] = "Volunteer Dashboard - Gift of the Givers";
var upcoming = Model.CurrentAssignments
        .Where(a => a.ReliefOperation != null && a.ReliefOperation.StartDate.Date >= DateTime.Today)
        .OrderBy(a => a.ReliefOperation!.StartDate)
        .FirstOrDefault();
    var next = upcoming ?? Model.CurrentAssignments.FirstOrDefault();
}

<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="dashboard-wrapper">
    <!-- Sidebar -->
    <partial name="Shared/_DashboardSidebar" />

    <!-- Main Content -->
    <div class="dashboard-main">
        <div class="dashboard-header">
            <h1 class="dashboard-header-title">Welcome back, @(Model.CurrentUser?.FirstName ?? "Volunteer")!</h1>
            <p class="dashboard-header-subtitle">Your assignments, availability and volunteer profile in one place</p>
        </div>

        <div class="dashboard-content">

            @if (Model.Profile == null)
            {
                <div class="dashboard-section">
                    <h2 class="dashboard-section-title">Not registered yet</h2>
                    <p>You haven't registered as a volunteer yet. <a href="/Volunteer">Register here</a> and we will review your application.</p>
                </div>
            }
            else
            {
                <!-- Next assignment card -->
                <div class="dashboard-section">
                    <h2 class="dashboard-section-title">Next Assignment</h2>
                    @if (next?.ReliefOperation != null)
                    {
                        <div class="activity-item">
                            <div class="activity-header">
                                <h4 class="activity-title">@next.ReliefOperation.OperationType</h4>
                                <span class="activity-date">@next.ReliefOperation.Location</span>
                            </div>
                            <div class="activity-meta">
                                <span>Start date: @next.ReliefOperation.StartDate.ToString("yyyy-MM-dd")</span>
                                <span>Status: @next.ReliefOperation.Status</span>
                                <span>Assigned: @next.AssignedDate.ToString("yyyy-MM-dd")</span>
                            </div>
                            <div style="margin-top: var(--spacing-md);">
                                <button class="btn btn-secondary" type="button" disabled>Check-in (coming soon)</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p>You have no assignments right now. Check back soon.</p>
                    }
                </div>

                <!-- Stats row -->
                <div class="stats-grid">
                    <div class="stat-card">
                        <span class="stat-label">Shifts Completed</span>
                        <span class="stat-value">@Model.CompletedAssignments.Count</span>
                        <span class="stat-meta">Relief operations</span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-label">Total Assignments</span>
                        <span class="stat-value">@Model.TotalAssignments</span>
                        <span class="stat-meta">All time</span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-label">Availability</span>
                        <span class="stat-value">@(Model.Profile.Availability)</span>
                        <span class="stat-meta">Current setting</span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-label">Volunteer Status</span>
                        <span class="stat-value">@(Model.Profile.Status)</span>
                        <span class="stat-meta">Since @Model.Profile.RegistrationDate.ToString("yyyy-MM-dd")</span>
                    </div>
                </div>

                <!-- Announcements (sample content for the prototype) -->
                <div class="dashboard-section">
                    <h2 class="dashboard-section-title">Announcements</h2>
                    <div class="activity-list">
                        <div class="activity-item">
                            <div class="activity-header">
                                <h4 class="activity-title">Volunteer briefing this weekend</h4>
                                <span class="activity-date">From the coordinator</span>
                            </div>
                            <p class="activity-description">All volunteers are asked to check their assignments and keep their availability up to date.</p>
                        </div>
                        <div class="activity-item">
                            <div class="activity-header">
                                <h4 class="activity-title">Safety reminder</h4>
                                <span class="activity-date">From the coordinator</span>
                            </div>
                            <p class="activity-description">Wear sturdy footwear and carry water on outdoor relief operations.</p>
                        </div>
                    </div>
                    <p class="stat-meta">Sample announcements for the prototype.</p>
                </div>

                <!-- Quick actions -->
                <div class="dashboard-section">
                    <h2 class="dashboard-section-title">Quick Actions</h2>
                    <div class="dashboard-actions">
                        <a href="#assignments" class="btn btn-primary">View Assignments</a>
                        <a href="#availability" class="btn btn-secondary">Update Availability</a>
                    </div>
                </div>

                <!-- Profile summary -->
                <div class="dashboard-section">
                    <h2 class="dashboard-section-title">Your Profile</h2>
                    <div class="profile-summary">
                        <div class="profile-field">
                            <span class="profile-label">Full Name</span>
                            <span class="profile-value">@(Model.CurrentUser?.FirstName) @(Model.CurrentUser?.LastName)</span>
                        </div>
                        <div class="profile-field">
                            <span class="profile-label">Email Address</span>
                            <span class="profile-value">@(Model.CurrentUser?.Email)</span>
                        </div>
                        <div class="profile-field">
                            <span class="profile-label">Phone Number</span>
                            <span class="profile-value">@(Model.CurrentUser?.PhoneNumber ?? "Not provided")</span>
                        </div>
                        <div class="profile-field">
                            <span class="profile-label">Skills</span>
                            <span class="profile-value">@(Model.Profile.Skills ?? "Not provided")</span>
                        </div>
                        <div class="profile-field">
                            <span class="profile-label">Availability</span>
                            <span class="profile-value">@(Model.Profile.Availability)</span>
                        </div>
                        <div class="profile-field">
                            <span class="profile-label">Member Since</span>
                            <span class="profile-value">@Model.Profile.RegistrationDate.ToString("yyyy-MM-dd")</span>
                        </div>
                    </div>
                </div>

                <!-- Current assignments -->
                <div class="dashboard-section" id="assignments">
                    <h2 class="dashboard-section-title">Current Assignments</h2>
                    <div class="dashboard-table">
                        <div class="dashboard-table-wrapper">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Operation</th>
                                        <th>Location</th>
                                        <th>Start Date</th>
                                        <th>Status</th>
                                        <th>Assigned</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var a in Model.CurrentAssignments)
                                    {
                                        <tr>
                                            <td><strong>@(a.ReliefOperation?.OperationType)</strong></td>
                                            <td>@(a.ReliefOperation?.Location)</td>
                                            <td>@(a.ReliefOperation?.StartDate.ToString("yyyy-MM-dd"))</td>
                                            <td><span class="status-badge active">@(a.ReliefOperation?.Status)</span></td>
                                            <td>@a.AssignedDate.ToString("yyyy-MM-dd")</td>
                                        </tr>
                                    }
                                    @if (!Model.CurrentAssignments.Any())
                                    {
                                        <tr><td colspan="5">No current assignments.</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Completed assignments -->
                <div class="dashboard-section">
                    <h2 class="dashboard-section-title">Completed Assignments</h2>
                    <div class="dashboard-table">
                        <div class="dashboard-table-wrapper">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Operation</th>
                                        <th>Location</th>
                                        <th>Ended</th>
                                        <th>Assigned</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var a in Model.CompletedAssignments)
                                    {
                                        <tr>
                                            <td><strong>@(a.ReliefOperation?.OperationType)</strong></td>
                                            <td>@(a.ReliefOperation?.Location)</td>
                                            <td>@(a.ReliefOperation?.EndDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                                            <td>@a.AssignedDate.ToString("yyyy-MM-dd")</td>
                                            <td><span class="status-badge active">@(a.ReliefOperation?.Status)</span></td>
                                        </tr>
                                    }
                                    @if (!Model.CompletedAssignments.Any())
                                    {
                                        <tr><td colspan="5">No completed assignments yet.</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Availability form -->
                <div class="dashboard-section" id="availability">
                    <h2 class="dashboard-section-title">Manage Your Availability</h2>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <p>@TempData["SuccessMessage"]</p>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <p>@TempData["ErrorMessage"]</p>
                    }

                    <div class="dashboard-form">
                        <form method="post">
                            <div class="dashboard-form-grid">
                                <div class="form-group-dashboard">
                                    <label for="availability-type">Availability</label>
                                    <select id="availability-type" name="availabilityType" required>
                                        @foreach (var opt in GiftOfTheGivers.Pages.Dashboards.VolunteerModel.AvailabilityOptions)
                                        {
                                            <option value="@opt" selected="@(Model.Profile.Availability == opt)">@opt</option>
                                        }
                                    </select>
                                </div>
                                <div style="grid-column: 1 / -1;" class="dashboard-actions">
                                    <button type="submit" class="btn btn-primary">Update Availability</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<script src="~/js/site.js"></script>


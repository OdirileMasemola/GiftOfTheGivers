@page "/Dashboards/Donor"
@model GiftOfTheGivers.Pages.Dashboards.DonorModel
@{
    ViewData["Title"] = "Donor Dashboard - Gift of the Givers";
    var displayName = Model.CurrentUser is null
        ? "Donor"
        : $"{Model.CurrentUser.FirstName} {Model.CurrentUser.LastName}".Trim();
}

<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="dashboard-wrapper">
    <partial name="Shared/_DashboardSidebar" />

    <div class="dashboard-main">
        <div class="dashboard-header">
            <h1 class="dashboard-header-title">Donor Dashboard</h1>
            <p class="dashboard-header-subtitle">
                Welcome@(string.IsNullOrWhiteSpace(displayName) ? "" : $", {displayName}"). Your donations and certificates.
            </p>
        </div>

        <div class="dashboard-content">
            @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
            {
                <div class="alert alert-info" role="status" style="margin-bottom: var(--spacing-lg);">
                    @Model.StatusMessage
                </div>
            }

            <div class="stats-grid">
                <div class="stat-card">
                    <span class="stat-label">Total donated (ZAR)</span>
                    <span class="stat-value">ZAR @Model.TotalCompletedZar.ToString("N2")</span>
                    <span class="stat-meta">Completed gifts in ZAR</span>
                </div>
                <div class="stat-card">
                    <span class="stat-label">Donations made</span>
                    <span class="stat-value">@Model.CompletedDonationCount</span>
                    <span class="stat-meta">Completed records</span>
                </div>
                <div class="stat-card">
                    <span class="stat-label">Active recurring</span>
                    <span class="stat-value">@Model.ActiveScheduleCount</span>
                    <span class="stat-meta">From your schedules</span>
                </div>
                <div class="stat-card">
                    <span class="stat-label">Tax certificates</span>
                    <span class="stat-value">@Model.TaxCertificateCount</span>
                    <span class="stat-meta">Linked to completed gifts</span>
                </div>
            </div>

            @if (Model.TotalsByCurrency.Count > 1 || (Model.TotalsByCurrency.Count == 1 && !Model.TotalsByCurrency.ContainsKey("ZAR")))
            {
                <div class="dashboard-section">
                    <h2 class="dashboard-section-title">Totals by currency</h2>
                    <ul class="activity-list">
                        @foreach (var pair in Model.TotalsByCurrency.OrderBy(p => p.Key))
                        {
                            <li class="activity-item">
                                <div class="activity-header">
                                    <h4 class="activity-title">@pair.Key</h4>
                                    <span class="activity-date">@pair.Value.ToString("N2")</span>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            }

            <div class="dashboard-section">
                <h2 class="dashboard-section-title">Quick actions</h2>
                <div class="donor-actions">
                    <a href="/Donate" class="btn btn-primary">Make a donation</a>
                </div>
            </div>

            <div class="dashboard-section">
                <h2 class="dashboard-section-title">Your donations</h2>
                @if (Model.Donations.Count == 0)
                {
                    <div class="empty-state">
                        <div class="empty-state-title">No donations yet</div>
                        <p class="empty-state-text">When you record a gift while signed in, it will appear here with tax certificate status.</p>
                        <a href="/Donate" class="btn btn-primary">Go to Donate</a>
                    </div>
                }
                else
                {
                    <div class="dashboard-table">
                        <div class="dashboard-table-wrapper">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                        <th>Reference</th>
                                        <th>Tax certificate</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var donation in Model.Donations)
                                    {
                                        var isCompleted = string.Equals(donation.PaymentStatus, "Completed", StringComparison.OrdinalIgnoreCase);
                                        var cert = donation.TaxCertificates.FirstOrDefault();
                                        var badgeClass = isCompleted ? "completed" : "pending";
                                        <tr>
                                            <td>@donation.DonationDate.ToString("yyyy-MM-dd")</td>
                                            <td>@donation.Currency @donation.Amount.ToString("N2")</td>
                                            <td><span class="status-badge @badgeClass">@donation.PaymentStatus</span></td>
                                            <td>@(donation.PaymentReference ?? "-")</td>
                                            <td>
                                                @if (cert is not null)
                                                {
                                                    <span class="status-badge active">@cert.CertificateNumber</span>
                                                }
                                                else if (isCompleted)
                                                {
                                                    <form method="post" asp-page-handler="RequestCertificate" style="display:inline;">
                                                        <input type="hidden" name="donationId" value="@donation.DonationId" />
                                                        <button type="submit" class="btn btn-outline btn-sm">Request certificate</button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <span class="status-badge inactive">Unavailable</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>

            @if (Model.Schedules.Count > 0)
            {
                <div class="dashboard-section">
                    <h2 class="dashboard-section-title">Recurring schedules</h2>
                    <div class="dashboard-table">
                        <div class="dashboard-table-wrapper">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Amount</th>
                                        <th>Frequency</th>
                                        <th>Start</th>
                                        <th>End</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var schedule in Model.Schedules)
                                    {
                                        var scheduleBadge = string.Equals(schedule.Status, "Active", StringComparison.OrdinalIgnoreCase)
                                            ? "active"
                                            : "inactive";
                                        <tr>
                                            <td>@schedule.Currency @schedule.Amount.ToString("N2")</td>
                                            <td>@schedule.Frequency</td>
                                            <td>@schedule.StartDate.ToString("yyyy-MM-dd")</td>
                                            <td>@(schedule.EndDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                                            <td><span class="status-badge @scheduleBadge">@schedule.Status</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<script src="~/js/site.js"></script>

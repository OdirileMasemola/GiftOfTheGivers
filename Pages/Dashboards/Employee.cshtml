@page "/Dashboards/Employee"
@model GiftOfTheGivers.Pages.Dashboards.EmployeeModel
@{
    ViewData["Title"] = "Employee Dashboard - Gift of the Givers";
}

<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="dashboard-wrapper">
    <!-- Sidebar -->
    <partial name="Shared/_DashboardSidebar" />

    <!-- Main Content -->
    <div class="dashboard-main">
        <!-- Header -->
        <div class="dashboard-header">
            <h1 class="dashboard-header-title">Employee Dashboard</h1>
            <p class="dashboard-header-subtitle">Monitor relief operations, volunteers and donation activity</p>
        </div>

        <!-- Content -->
        <div class="dashboard-content">
            <!-- Statistics Grid -->
            <div class="stats-grid">
                <div class="stat-card">
                    <span class="stat-label">Active Relief Operations</span>
                    <span class="stat-value">@Model.ActiveOperations</span>
                    <span class="stat-meta">Active and planning</span>
                </div>
                <div class="stat-card">
                    <span class="stat-label">Volunteer Sign-ups</span>
                    <span class="stat-value">@Model.TotalVolunteers</span>
                    <span class="stat-meta">@(Model.PendingVolunteers == 0 ? "All reviewed" : Model.PendingVolunteers + " pending review")</span>
                </div>
                <div class="stat-card">
                    <span class="stat-label">Donations Received</span>
                    <span class="stat-value">ZAR @Model.MonthDonationsZar.ToString("N0")</span>
                    <span class="stat-meta">This month</span>
                </div>
                <div class="stat-card">
                    <span class="stat-label">Operations Managed</span>
                    <span class="stat-value">@Model.CommunitiesSupported</span>
                    <span class="stat-meta">Active regions</span>
                </div>
            </div>

            <!-- Active Relief Operations Section -->
            <div class="dashboard-section">
                <div class="dashboard-section-header">
                    <h2 class="dashboard-section-title">Relief Operations</h2>
                </div>

                <div class="dashboard-table">
                    <div class="dashboard-table-wrapper">
                        @if (Model.Operations.Count == 0)
                        {
                            <div class="empty-state">
                                <p class="empty-state-title">No operations yet</p>
                                <p class="empty-state-text">Create a new relief operation to get started.</p>
                            </div>
                        }
                        else
                        {
                            <table>
                                <thead>
                                    <tr>
                                        <th>Operation</th>
                                        <th>Location</th>
                                        <th>Status</th>
                                        <th>Start Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var operation in Model.Operations)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@operation.OperationType</strong>
                                            </td>
                                            <td>@operation.Location</td>
                                            <td>
                                                <span class="status-badge @operation.Status.ToLower()">@operation.Status</span>
                                            </td>
                                            <td>@operation.StartDate.ToString("d MMM yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>

            <!-- Recent Volunteers Section -->
            <div class="dashboard-section">
                <div class="dashboard-section-header">
                    <h2 class="dashboard-section-title">Recent Volunteers</h2>
                </div>

                <div class="dashboard-table">
                    <div class="dashboard-table-wrapper">
                        @if (Model.RecentVolunteers.Count == 0)
                        {
                            <div class="empty-state">
                                <p class="empty-state-title">No volunteers yet</p>
                                <p class="empty-state-text">Volunteers will appear here after they register.</p>
                            </div>
                        }
                        else
                        {
                            <table>
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Skills</th>
                                        <th>Status</th>
                                        <th>Registered</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var volunteer in Model.RecentVolunteers)
                                    {
                                        var volunteerName = volunteer.User != null ? $"{volunteer.User.FirstName} {volunteer.User.LastName}" : "Unknown";
                                        var volunteerEmail = volunteer.User?.Email ?? "N/A";
                                        <tr>
                                            <td>
                                                <strong>@volunteerName</strong>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(volunteerEmail) && volunteerEmail != "N/A")
                                                {
                                                    <a href="mailto:@volunteerEmail">@volunteerEmail</a>
                                                }
                                                else
                                                {
                                                    <span>N/A</span>
                                                }
                                            </td>
                                            <td>@(volunteer.Skills ?? "No skills listed")</td>
                                            <td>
                                                <span class="status-badge @volunteer.Status.ToLower()">@volunteer.Status</span>
                                            </td>
                                            <td>@volunteer.RegistrationDate.ToString("d MMM yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>

            <!-- Recent Donations Section -->
            <div class="dashboard-section">
                <div class="dashboard-section-header">
                    <h2 class="dashboard-section-title">Recent Donations</h2>
                </div>

                <div class="dashboard-table">
                    <div class="dashboard-table-wrapper">
                        @if (Model.RecentDonations.Count == 0)
                        {
                            <div class="empty-state">
                                <p class="empty-state-title">No donations yet</p>
                                <p class="empty-state-text">Donations will appear here when received.</p>
                            </div>
                        }
                        else
                        {
                            <table>
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Donor</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var donation in Model.RecentDonations)
                                    {
                                        var donorName = donation.User != null ? $"{donation.User.FirstName} {donation.User.LastName}" : "Anonymous";
                                        <tr>
                                            <td>@donation.DonationDate.ToString("d MMM yyyy")</td>
                                            <td>
                                                <strong>@donorName</strong>
                                            </td>
                                            <td>@donation.Currency @donation.Amount.ToString("N0")</td>
                                            <td>
                                                <span class="status-badge @(donation.PaymentStatus == "Completed" ? "completed" : "pending")">
                                                    @donation.PaymentStatus
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@page "/Dashboards/Operations"
@model GiftOfTheGivers.Pages.Dashboards.OperationsModel
@{
    ViewData["Title"] = "Operations - Gift of the Givers";
}

<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="dashboard-wrapper">
    <partial name="Shared/_DashboardSidebar" />

    <div class="dashboard-main">
        <div class="dashboard-header">
            <h1 class="dashboard-header-title">Relief Operations</h1>
            <p class="dashboard-header-subtitle">Create and manage relief operations</p>
        </div>

        <div class="dashboard-content">
            <!-- Stats -->
            <div class="stats-grid">
                <div class="stat-card">
                    <span class="stat-label">All Operations</span>
                    <span class="stat-value">@Model.Operations.Count</span>
                    <span class="stat-meta">Total</span>
                </div>
                <div class="stat-card">
                    <span class="stat-label">Active</span>
                    <span class="stat-value">@Model.ActiveCount</span>
                    <span class="stat-meta">Currently running</span>
                </div>
                <div class="stat-card">
                    <span class="stat-label">Planning</span>
                    <span class="stat-value">@Model.PlanningCount</span>
                    <span class="stat-meta">In preparation</span>
                </div>
                <div class="stat-card">
                    <span class="stat-label">Completed</span>
                    <span class="stat-value">@Model.CompletedCount</span>
                    <span class="stat-meta">Finished</span>
                </div>
            </div>

            <!-- Create New Operation -->
            <div class="dashboard-section">
                <h2 class="dashboard-section-title">Create New Operation</h2>
                <form method="post" asp-page-handler="Create">
                    <div class="form-section">
                        <div class="form-group">
                            <label for="OperationType">Operation Type *</label>
                            <input id="OperationType" asp-for="OperationType" placeholder="e.g. Emergency Medical Support" required />
                            <span asp-validation-for="OperationType" class="invalid-feedback"></span>
                        </div>

                        <div class="form-group">
                            <label for="Location">Location *</label>
                            <input id="Location" asp-for="Location" placeholder="e.g. Eastern Cape" required />
                            <span asp-validation-for="Location" class="invalid-feedback"></span>
                        </div>

                        <div class="form-group">
                            <label for="Notes">Notes</label>
                            <textarea id="Notes" asp-for="Notes" placeholder="Notes about this operation"></textarea>
                        </div>

                        <div class="form-group">
                            <label for="Status">Status *</label>
                            <select id="Status" asp-for="Status" required>
                                <option value="">Select status...</option>
                                <option value="Planning">Planning</option>
                                <option value="Active">Active</option>
                                <option value="Completed">Completed</option>
                                <option value="Paused">Paused</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="StartDate">Start Date *</label>
                            <input type="date" id="StartDate" asp-for="StartDate" required />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary">Create Operation</button>
                </form>
            </div>

            <!-- Operations List -->
            <div class="dashboard-section">
                <h2 class="dashboard-section-title">All Operations</h2>
                <div class="dashboard-table">
                    <div class="dashboard-table-wrapper">
                        @if (Model.Operations.Count == 0)
                        {
                            <div class="empty-state">
                                <p class="empty-state-title">No operations yet</p>
                                <p class="empty-state-text">Create a new relief operation above to get started.</p>
                            </div>
                        }
                        else
                        {
                            <table>
                                <thead>
                                    <tr>
                                        <th>Operation Type</th>
                                        <th>Location</th>
                                        <th>Status</th>
                                        <th>Start Date</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var operation in Model.Operations)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@operation.OperationType</strong>
                                            </td>
                                            <td>@operation.Location</td>
                                            <td>
                                                <span class="status-badge @operation.Status.ToLower()">@operation.Status</span>
                                            </td>
                                            <td>@operation.StartDate.ToString("d MMM yyyy")</td>
                                            <td>
                                                <div class="action-buttons">
                                                    @if (operation.Status != "Completed")
                                                    {
                                                        <form method="post" style="display: inline;">
                                                            <input type="hidden" name="id" value="@operation.ReliefOperationId" />
                                                            <input type="hidden" name="status" value="Completed" />
                                                            <button type="submit" asp-page-handler="UpdateStatus" class="btn btn-sm btn-success">Mark Complete</button>
                                                        </form>
                                                    }
                                                    @if (operation.Status == "Active")
                                                    {
                                                        <form method="post" style="display: inline;">
                                                            <input type="hidden" name="id" value="@operation.ReliefOperationId" />
                                                            <input type="hidden" name="status" value="Paused" />
                                                            <button type="submit" asp-page-handler="UpdateStatus" class="btn btn-sm btn-warning">Pause</button>
                                                        </form>
                                                    }
                                                    @if (operation.Status == "Paused" || operation.Status == "Planning")
                                                    {
                                                        <form method="post" style="display: inline;">
                                                            <input type="hidden" name="id" value="@operation.ReliefOperationId" />
                                                            <input type="hidden" name="status" value="Active" />
                                                            <button type="submit" asp-page-handler="UpdateStatus" class="btn btn-sm btn-info">Activate</button>
                                                        </form>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Any scripts needed for operations dashboard
    </script>
}

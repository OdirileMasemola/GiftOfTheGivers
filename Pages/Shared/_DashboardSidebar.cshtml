@{
    // Get user role from claims (custom authentication)
    var userRole = User?.FindFirst("http://schemas.microsoft.com/ws/2008/06/identity/claims/role")?.Value ?? "Donor";
    var path = Context.Request.Path.Value ?? string.Empty;
    var userName = User?.FindFirst("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name")?.Value ?? "Guest User";

    string NavClass(string href) =>
        path.Equals(href, StringComparison.OrdinalIgnoreCase)
            ? "sidebar-nav-link active"
            : "sidebar-nav-link";
}

<aside class="dashboard-sidebar">
    <a href="/" class="sidebar-brand">
        <div class="sidebar-brand-icon">G</div>
        <div class="sidebar-brand-text">Gift of the Givers</div>
    </a>

    <nav>
        <ul class="sidebar-nav">
            @if (userRole == "Employee")
            {
                <li class="sidebar-nav-item">
                    <a href="/Dashboards/Employee" class="@NavClass("/Dashboards/Employee")">
                        <span class="sidebar-nav-icon"><i class="bi bi-speedometer2" aria-hidden="true"></i></span>
                        <span>Overview</span>
                    </a>
                </li>
                <li class="sidebar-nav-item">
                    <a href="/Dashboards/Operations" class="@NavClass("/Dashboards/Operations")">
                        <span class="sidebar-nav-icon"><i class="bi bi-flag" aria-hidden="true"></i></span>
                        <span>Relief Operations</span>
                    </a>
                </li>
                <li class="sidebar-nav-item">
                    <a href="/Dashboards/Volunteers" class="@NavClass("/Dashboards/Volunteers")">
                        <span class="sidebar-nav-icon"><i class="bi bi-people" aria-hidden="true"></i></span>
                        <span>Volunteers</span>
                    </a>
                </li>
                <li class="sidebar-nav-item">
                    <a href="/Dashboards/Donations" class="@NavClass("/Dashboards/Donations")">
                        <span class="sidebar-nav-icon"><i class="bi bi-cash-stack" aria-hidden="true"></i></span>
                        <span>Donations</span>
                    </a>
                </li>
            }

            @if (userRole == "Donor")
            {
                <li class="sidebar-nav-item">
                    <a href="/Dashboards/Donor" class="@NavClass("/Dashboards/Donor")">
                        <span class="sidebar-nav-icon"><i class="bi bi-heart" aria-hidden="true"></i></span>
                        <span>My Donations</span>
                    </a>
                </li>
                <li class="sidebar-nav-item">
                    <a href="/Donate" class="@NavClass("/Donate")">
                        <span class="sidebar-nav-icon"><i class="bi bi-gift" aria-hidden="true"></i></span>
                        <span>Make a Donation</span>
                    </a>
                </li>
            }

            @if (userRole == "Volunteer" || userRole == "Donor")
            {
                <li class="sidebar-nav-item">
                    <a href="/Dashboards/Volunteer" class="@NavClass("/Dashboards/Volunteer")">
                        <span class="sidebar-nav-icon"><i class="bi bi-person" aria-hidden="true"></i></span>
                        <span>My Profile</span>
                    </a>
                </li>
            }

            <li class="sidebar-nav-item">
                <a href="/Dashboards/Settings" class="@NavClass("/Dashboards/Settings")">
                    <span class="sidebar-nav-icon"><i class="bi bi-gear" aria-hidden="true"></i></span>
                    <span>Settings</span>
                </a>
            </li>
        </ul>
    </nav>

    <div class="sidebar-profile">
        <div class="sidebar-profile-name">@userName</div>
        <div class="sidebar-profile-role">@userRole</div>

        <form method="post" asp-page="/Logout" asp-route-returnUrl="/">
            <button type="submit" class="sidebar-sign-out">
                <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                <span>Sign Out</span>
            </button>
        </form>
    </div>
</aside>
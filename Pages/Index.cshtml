@page
@model IndexModel
@{
    ViewData["Title"] = "Home - Gift of the Givers Disaster Relief";
}

<partial name="Shared/_Navigation" />

<!-- hero section -->
<section class="hero-section">

    <div class="hero-media" aria-hidden="true">
        <img src="~/images/hero-relief.jpg"
             alt=""
             class="hero-image" />
    </div>

    <div class="hero-overlay"></div>

    <div class="container hero-container">
        <div class="hero-content">

            <span class="hero-label">
                Disaster Relief &amp; Community Support
            </span>

            <h1>
                Together, We Can<br />
                Make a Difference.
            </h1>

            <p class="hero-subtitle">
                Responding to disasters, restoring hope and supporting
                communities when they need it most.
            </p>

            <div class="hero-actions">
                <a href="/Donate" class="btn btn-primary btn-large">
                    Donate Now
                </a>
                <a href="/Volunteer" class="btn btn-light-outline btn-large">
                    Become a Volunteer
                </a>
            </div>

            <div class="hero-trust">
                <div class="trust-item">
                    <strong>Rapid Response</strong>
                    <span>When communities need us</span>
                </div>
                <div class="trust-divider"></div>
                <div class="trust-item">
                    <strong>Community Focused</strong>
                    <span>Helping those who need it most</span>
                </div>
            </div>

        </div>
    </div>

    <a href="#our-work" class="hero-scroll-hint">
        <span>Scroll</span>
        <span class="hero-scroll-icon" aria-hidden="true"></span>
    </a>

</section>


<!-- services section -->
<section class="services-section" id="our-work" data-scroll-reveal>

    <div class="container">

        <div class="section-heading">

            <span>OUR WORK</span>

            <h2>
                How We Make a Difference
            </h2>

            <p>
                We provide practical humanitarian assistance to communities
                facing disasters, poverty and emergencies.
            </p>

        </div>


        <div class="services-grid">

            <div class="service-card">

                <div class="service-icon">
                    <i class="bi bi-truck" aria-hidden="true"></i>
                </div>

                <h3>
                    Disaster Relief
                </h3>

                <p>
                    Providing emergency assistance and essential supplies
                    to communities affected by disasters.
                </p>

            </div>


            <div class="service-card">

                <div class="service-icon">
                    <i class="bi bi-droplet" aria-hidden="true"></i>
                </div>

                <h3>
                    Food & Water
                </h3>

                <p>
                    Delivering food, clean water and other necessities
                    to people experiencing hardship.
                </p>

            </div>


            <div class="service-card">

                <div class="service-icon">
                    <i class="bi bi-heart" aria-hidden="true"></i>
                </div>

                <h3>
                    Community Support
                </h3>

                <p>
                    Supporting communities through sustainable humanitarian
                    projects and recovery initiatives.
                </p>

            </div>

        </div>

    </div>

</section>


<!-- impact -->
<section class="impact-band">
    <div class="container impact-band-inner">
        <div class="impact-intro">
            <span class="section-label">Our impact</span>
            <h2>Real support, measured in people helped.</h2>
        </div>

        <div class="impact-metrics">
            <div class="impact-metric">
                <span class="impact-number">@Model.ActiveOperations</span>
                <span class="impact-label">Active operations</span>
            </div>
            <div class="impact-metric">
                <span class="impact-number">@Model.RegisteredVolunteers</span>
                <span class="impact-label">Registered volunteers</span>
            </div>
            <div class="impact-metric">
                <span class="impact-number">@Model.TotalDonations.ToString("C0")</span>
                <span class="impact-label">Funds received</span>
            </div>
            <div class="impact-metric">
                <span class="impact-number">@Model.OperationsSupported</span>
                <span class="impact-label">Communities served</span>
            </div>
        </div>
    </div>
</section>


<!-- current operations -->
<section class="operations-section">
    <div class="container">

        <div class="operations-intro">
            <div>
                <span class="section-label">On the ground</span>
                <h2>Current relief operations</h2>
            </div>
            <p>
                Live disaster response and community assistance
                we are supporting right now.
            </p>
        </div>

        @if (Model.RecentOperations != null && Model.RecentOperations.Any())
        {
            var featuredProject = Model.RecentOperations.First();
            var otherProjects = Model.RecentOperations.Skip(1).ToList();

            <article class="operation-featured">
                <div class="operation-featured-media">
                    <img src="~/images/hero-relief.jpg"
                         alt=""
                         class="operation-featured-image" />
                    <span class="operation-status">@featuredProject.Status</span>
                </div>
                <div class="operation-featured-body">
                    <span class="operation-location">
                        <i class="bi bi-geo-alt-fill" aria-hidden="true"></i>
                        @featuredProject.Location
                    </span>
                    <h3>@(featuredProject.ReliefRequest?.RequestType ?? "Relief Operation")</h3>
                    <p>@(featuredProject.ReliefRequest?.Description ?? featuredProject.Notes ?? "Learn more about this operation")</p>
                    <a href="/Donate" class="btn btn-primary">Support this operation</a>
                </div>
            </article>

            @if (otherProjects.Any())
            {
                <ol class="operation-list">
                    @for (var i = 0; i < otherProjects.Count; i++)
                    {
                        var project = otherProjects[i];
                        <li class="operation-row">
                            <span class="operation-index">@((i + 2).ToString("00"))</span>
                            <div class="operation-row-copy">
                                <h3>@(featuredProject.ReliefRequest?.RequestType ?? "Relief Operation")</h3>
                                <p>
                                    <i class="bi bi-geo-alt-fill" aria-hidden="true"></i>
                                    @project.Location
                                    <span class="operation-row-status">@project.Status</span>
                                </p>
                            </div>
                            <a href="/Donate" class="operation-row-link">
                                Support
                                <i class="bi bi-arrow-right" aria-hidden="true"></i>
                            </a>
                        </li>
                    }
                </ol>
            }
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon">
                    <i class="bi bi-heart" aria-hidden="true"></i>
                </div>
                <h3>No active relief operations</h3>
                <p>There are currently no active relief operations. Please check back soon.</p>
            </div>
        }

    </div>
</section>


<!-- get involved -->
<section class="involve-split">
    <a href="/Donate" class="involve-panel involve-donate">
        <span class="involve-kicker">Give</span>
        <h2>Make a donation</h2>
        <p>Fund food, water and emergency relief for communities that need it now.</p>
        <span class="involve-link">
            Donate now
            <i class="bi bi-arrow-right" aria-hidden="true"></i>
        </span>
    </a>
    <a href="/Volunteer" class="involve-panel involve-volunteer">
        <span class="involve-kicker">Serve</span>
        <h2>Become a volunteer</h2>
        <p>Join response teams on the ground and put your skills where they matter most.</p>
        <span class="involve-link">
            Join the team
            <i class="bi bi-arrow-right" aria-hidden="true"></i>
        </span>
    </a>
</section>


<partial name="Shared/_Footer" />
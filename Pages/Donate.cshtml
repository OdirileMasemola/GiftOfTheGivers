@page
@model DonateModel
@{
    ViewData["Title"] = "Donate - Gift of the Givers";
    var successMessage = TempData["DonationMessage"] as string;
    var isSuccess = TempData["DonationSuccess"] as bool? == true;
}

<partial name="Shared/_Navigation" />

<div class="form-container">
    <div class="page-header">
        <h1>Make a Donation</h1>
        <p>Your support helps us provide relief to affected communities.</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert @(isSuccess ? "alert-success" : "alert-info")" role="status">
            <strong>Donation recorded.</strong> @successMessage
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div style="margin-top: 0.75rem;">
                    <a href="/Dashboards/Donor" class="btn btn-secondary">View donor dashboard</a>
                </div>
            }
        </div>
    }

    <div class="alert alert-info">
        <strong>Recording only:</strong> This demonstration system does not process real card or bank payments.
        Submitted amounts are stored as completed donation records for tracking and tax-certificate demos.
    </div>

    <form method="post" id="donationForm" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="form-section">
            <div class="form-section-title">Amount and currency</div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label" asp-for="Currency">Currency</label>
                    <select class="form-control" asp-for="Currency">
                        <option value="ZAR">South African Rand (ZAR)</option>
                        <option value="USD">US Dollar (USD)</option>
                        <option value="EUR">Euro (EUR)</option>
                    </select>
                    <span asp-validation-for="Currency" class="field-validation-error"></span>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Quick amounts</label>
                <div class="amount-options">
                    <button type="button" class="amount-button" data-amount="500" onclick="selectAmount(this, 500)">500</button>
                    <button type="button" class="amount-button" data-amount="1000" onclick="selectAmount(this, 1000)">1000</button>
                    <button type="button" class="amount-button" data-amount="2500" onclick="selectAmount(this, 2500)">2500</button>
                    <button type="button" class="amount-button" data-amount="5000" onclick="selectAmount(this, 5000)">5000</button>
                </div>
                <p class="form-help-text">Or enter a custom amount below. Maximum 1,000,000.</p>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="Amount">Donation amount</label>
                <input class="form-control" asp-for="Amount" type="number" inputmode="decimal"
                       placeholder="Enter amount" step="0.01" min="0.01" max="1000000" required />
                <span asp-validation-for="Amount" class="field-validation-error"></span>
            </div>
        </div>

        <div class="submit-section">
            <button type="submit" class="btn btn-primary btn-large">Record donation</button>
            @if (User.Identity?.IsAuthenticated != true)
            {
                <p class="form-help-text" style="margin-top: 1rem;">
                    You can donate as a guest. Sign in first if you want this gift on your donor dashboard.
                    <a href="/Login">Sign in</a>
                </p>
            }
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function selectAmount(button, amount) {
            document.querySelectorAll('.amount-button').forEach(btn => btn.classList.remove('active'));
            button.classList.add('active');
            document.getElementById('Amount').value = amount;
        }

        document.getElementById('donationForm').addEventListener('submit', function (e) {
            const amountInput = document.getElementById('Amount');
            const amount = parseFloat(amountInput.value);
            if (!amount || amount <= 0 || amount > 1000000) {
                e.preventDefault();
                amountInput.classList.add('is-invalid');
            }
        });
    </script>
}

<partial name="Shared/_Footer" />

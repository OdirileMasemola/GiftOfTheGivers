@page
@model DonateModel
@{
    ViewData["Title"] = "Donate - Gift of the Givers";
}

<partial name="Shared/_Navigation" />

<div class="form-container">
    <div class="page-header">
        <h1>Make a Donation</h1>
        <p>Your support helps us provide relief to affected communities.</p>
    </div>

    <div class="alert alert-info">
        <strong>Prototype Notice:</strong> This is a demonstration system. No real payment processing occurs. Donations are recorded for tracking purposes only.
    </div>

    <form method="post" id="donationForm">
        <!-- Donation Type Section -->
        <div class="form-section">
            <div class="form-section-title">Donation Type</div>
            <div class="form-group">
                <div class="form-check">
                    <input class="form-check-input" type="radio" id="donationType_OneTime" name="DonationType" value="OneTime"
                           checked asp-for="DonationType" onchange="handleDonationTypeChange()">
                    <label class="form-check-label" for="donationType_OneTime">One-Time Donation</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" id="donationType_Recurring" name="DonationType" value="Recurring"
                           asp-for="DonationType" onchange="handleDonationTypeChange()">
                    <label class="form-check-label" for="donationType_Recurring">Recurring Donation</label>
                </div>
            </div>
        </div>

        <!-- Recurring Options (Initially Hidden) -->
        <div class="recurring-options" id="recurringOptions">
            <div class="form-group">
                <label class="form-label" for="RecurringFrequency">Frequency</label>
                <select class="form-control" id="RecurringFrequency" name="RecurringFrequency" asp-for="RecurringFrequency">
                    <option value="">Select frequency...</option>
                    <option value="Monthly">Monthly</option>
                    <option value="Quarterly">Quarterly</option>
                </select>
            </div>
        </div>

        <!-- Currency & Amount Section -->
        <div class="form-section">
            <div class="form-section-title">Amount & Currency</div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label" for="Currency">Currency</label>
                    <select class="form-control" id="Currency" name="Currency" asp-for="Currency">
                        <option value="ZAR">South African Rand (ZAR)</option>
                        <option value="USD">US Dollar (USD)</option>
                        <option value="EUR">Euro (EUR)</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Select Amount</label>
                <div class="amount-options">
                    <button type="button" class="amount-button" data-amount="500" onclick="selectAmount(this, 500)">500</button>
                    <button type="button" class="amount-button" data-amount="1000" onclick="selectAmount(this, 1000)">1000</button>
                    <button type="button" class="amount-button" data-amount="2500" onclick="selectAmount(this, 2500)">2500</button>
                    <button type="button" class="amount-button" data-amount="5000" onclick="selectAmount(this, 5000)">5000</button>
                </div>
                <p class="help-text">Or enter a custom amount below</p>
            </div>

            <div class="form-group">
                <label class="form-label" for="Amount">Custom Amount</label>
                <input type="number" class="form-control" id="Amount" name="Amount"
                       placeholder="Enter amount" step="0.01" min="1" asp-for="Amount" required>
                <span class="invalid-feedback" id="amountError"></span>
            </div>
        </div>

        <!-- Donor Information Section -->
        <div class="form-section">
            <div class="form-section-title">Your Information</div>

            <div class="form-group">
                <label class="form-label" for="DonorName">Full Name</label>
                <input type="text" class="form-control" id="DonorName" name="DonorName"
                       placeholder="Your full name" asp-for="DonorName" required>
                <span class="invalid-feedback"></span>
            </div>

            <div class="form-group">
                <label class="form-label" for="DonorEmail">Email Address</label>
                <input type="email" class="form-control" id="DonorEmail" name="DonorEmail"
                       placeholder="your@email.com" asp-for="DonorEmail" required>
                <span class="invalid-feedback"></span>
            </div>
        </div>

        <!-- Submit -->
        <div class="submit-section">
            <button type="submit" class="btn btn-primary btn-large">Proceed to Donation</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function handleDonationTypeChange() {
            const isRecurring = document.getElementById('donationType_Recurring').checked;
            const recurringOptions = document.getElementById('recurringOptions');
            if (isRecurring) {
                recurringOptions.classList.add('show');
            } else {
                recurringOptions.classList.remove('show');
            }
        }

        function selectAmount(button, amount) {
            document.querySelectorAll('.amount-button').forEach(btn => btn.classList.remove('active'));
            button.classList.add('active');
            document.getElementById('Amount').value = amount;
        }

        document.getElementById('donationForm').addEventListener('submit', function (e) {
            const amount = parseFloat(document.getElementById('Amount').value);
            if (!amount || amount <= 0) {
                e.preventDefault();
                document.getElementById('amountError').textContent = 'Please enter a valid amount greater than 0';
                document.getElementById('Amount').classList.add('is-invalid');
            }
        });
    </script>
}

<partial name="Shared/_Footer" />

@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/navbar.css" />
    <link rel="stylesheet" href="~/css/pages.css" />
</head>
<body>
    <partial name="Shared/_Navigation" />

    <main>
        <div class="error-container">
            <div class="error-content">
                <div class="error-icon">Access Denied</div>
                <h1 class="error-title">403 - Access Denied</h1>
                <p class="error-message">
                    You do not have permission to access this resource. 
                    <br/>
                    <small>If you believe this is a mistake, please contact support.</small>
                </p>
                <div class="action-buttons">
                    <a href="/" class="btn btn-primary">Return to Home</a>
                    <a href="javascript:history.back()" class="btn btn-secondary">Go Back</a>
                </div>
            </div>
        </div>
    </main>

    <partial name="Shared/_Footer" />

    <script src="~/js/site.js"></script>
</body>
</html>

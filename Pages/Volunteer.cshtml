@page
@model VolunteerModel
@{
    ViewData["Title"] = "Volunteer - Gift of the Givers Disaster Relief";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/navbar.css" />
    <link rel="stylesheet" href="~/css/pages.css" />
</head>
<body>
    <partial name="Shared/_Navigation" />

    <main>
        <div class="volunteer-container">
            <div class="volunteer-header">
                <h1>Volunteer With Us</h1>
                <p>Join our team and help make a difference in disaster relief efforts.</p>
            </div>

            <div class="info-box">
                ✓ We're always looking for dedicated volunteers. After you register, our team will review your application and contact you with opportunities.
            </div>

            <form method="post" id="volunteerForm">
                <!-- Personal Information -->
                <div class="form-section">
                    <div class="form-section-title">Personal Information</div>

                    <div class="form-group">
                        <label class="form-label" for="Name">Full Name *</label>
                        <input type="text" class="form-control" id="Name" name="Name" 
                               placeholder="Your full name" asp-for="Name" required>
                        <span asp-validation-for="Name" class="invalid-feedback"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="Email">Email Address *</label>
                        <input type="email" class="form-control" id="Email" name="Email" 
                               placeholder="your@email.com" asp-for="Email" required>
                        <span asp-validation-for="Email" class="invalid-feedback"></span>
                    </div>
                </div>

                <!-- Skills -->
                <div class="form-section mt-3">
                    <div class="form-section-title">Skills & Experience</div>

                    <p style="color: #666; margin-bottom: 1rem;">Select all that apply:</p>

                    <div class="skill-checkboxes">
                        <div class="skill-checkbox">
                            <input type="checkbox" id="skill_medical" name="SelectedSkills" value="Medical" />
                            <label for="skill_medical">Medical/Healthcare</label>
                        </div>
                        <div class="skill-checkbox">
                            <input type="checkbox" id="skill_logistics" name="SelectedSkills" value="Logistics" />
                            <label for="skill_logistics">Logistics</label>
                        </div>
                        <div class="skill-checkbox">
                            <input type="checkbox" id="skill_communications" name="SelectedSkills" value="Communications" />
                            <label for="skill_communications">Communications</label>
                        </div>
                        <div class="skill-checkbox">
                            <input type="checkbox" id="skill_construction" name="SelectedSkills" value="Construction" />
                            <label for="skill_construction">Construction</label>
                        </div>
                        <div class="skill-checkbox">
                            <input type="checkbox" id="skill_counselling" name="SelectedSkills" value="Counselling" />
                            <label for="skill_counselling">Counselling</label>
                        </div>
                        <div class="skill-checkbox">
                            <input type="checkbox" id="skill_administration" name="SelectedSkills" value="Administration" />
                            <label for="skill_administration">Administration</label>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="Skills">Other Skills or Experience *</label>
                        <textarea class="form-control" id="Skills" name="Skills" rows="3"
                                  placeholder="Describe any other relevant skills, certifications, or experience (e.g., First Aid, Heavy Equipment Operation, etc.)"
                                  asp-for="Skills" required></textarea>
                        <span asp-validation-for="Skills" class="invalid-feedback"></span>
                    </div>
                </div>

                <!-- Availability -->
                <div class="form-section mt-3">
                    <div class="form-section-title">Availability</div>

                    <p style="color: #666; margin-bottom: 1rem;">How often can you volunteer? *</p>

                    <div class="availability-options">
                        <div class="availability-radio">
                            <input type="radio" id="avail_fulltime" name="Availability" value="Full-time" 
                                   asp-for="Availability" required />
                            <label for="avail_fulltime">Full-time</label>
                        </div>
                        <div class="availability-radio">
                            <input type="radio" id="avail_parttime" name="Availability" value="Part-time" 
                                   asp-for="Availability" required />
                            <label for="avail_parttime">Part-time</label>
                        </div>
                        <div class="availability-radio">
                            <input type="radio" id="avail_weekends" name="Availability" value="Weekends only" 
                                   asp-for="Availability" required />
                            <label for="avail_weekends">Weekends only</label>
                        </div>
                        <div class="availability-radio">
                            <input type="radio" id="avail_occasional" name="Availability" value="Occasional" 
                                   asp-for="Availability" required />
                            <label for="avail_occasional">Occasional</label>
                        </div>
                    </div>

                    <span asp-validation-for="Availability" class="invalid-feedback"></span>
                </div>

                <!-- Submit -->
                <div class="submit-section">
                    <button type="submit" class="btn btn-primary btn-large">Submit Application</button>
                </div>
            </form>
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        document.getElementById('volunteerForm').addEventListener('submit', function(e) {
            const selectedSkills = Array.from(document.querySelectorAll('input[name="SelectedSkills"]:checked')).map(cb => cb.value);
            const otherSkills = document.getElementById('Skills').value.trim();

            if (selectedSkills.length === 0 && !otherSkills) {
                e.preventDefault();
                alert('Please select at least one skill or describe your experience.');
            }
        });
    </script>
</body>
</html>

@page
@model VolunteerModel
@{
    ViewData["Title"] = "Volunteer - Gift of the Givers Disaster Relief";
}

<partial name="Shared/_Navigation" />

<section class="page-header volunteer-hero">
    <h1>Volunteer With Us</h1>
    <p>Support disaster relief efforts with your time, skills, and compassion.</p>
</section>

<main class="volunteer-page">
    <section class="volunteer-intro">
        <h2>Help communities recover</h2>
        <p>Tell us how you can help. Our team reviews every application and will contact you about suitable opportunities and next steps.</p>
    </section>

    <div class="form-container">
        <form method="post" id="volunteerForm">
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

        <!-- Personal Information -->
        <div class="form-section">
            <div class="form-section-title">Personal Information</div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label" asp-for="FirstName">First Name *</label>
                    <input class="form-control" placeholder="Your first name" asp-for="FirstName" />
                    <span asp-validation-for="FirstName" class="invalid-feedback"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="LastName">Last Name *</label>
                    <input class="form-control" placeholder="Your last name" asp-for="LastName" />
                    <span asp-validation-for="LastName" class="invalid-feedback"></span>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="Email">Email Address *</label>
                <input class="form-control" placeholder="your@email.com" asp-for="Email" />
                <span asp-validation-for="Email" class="invalid-feedback"></span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="PhoneNumber">Phone Number</label>
                <input class="form-control" placeholder="Your phone number" asp-for="PhoneNumber" />
                <span asp-validation-for="PhoneNumber" class="invalid-feedback"></span>
            </div>
        </div>

        <!-- Skills -->
        <div class="form-section">
            <div class="form-section-title">Skills & Experience</div>

            <p class="form-help-text">Select all that apply:</p>

            <div class="skill-checkboxes">
                <div class="form-check">
                    <input type="checkbox" id="skill_medical" asp-for="SelectedSkills" value="Medical" class="form-check-input" />
                    <label for="skill_medical" class="form-check-label">Medical / Healthcare</label>
                </div>
                <div class="form-check">
                    <input type="checkbox" id="skill_logistics" asp-for="SelectedSkills" value="Logistics" class="form-check-input" />
                    <label for="skill_logistics" class="form-check-label">Logistics</label>
                </div>
                <div class="form-check">
                    <input type="checkbox" id="skill_communications" asp-for="SelectedSkills" value="Communications" class="form-check-input" />
                    <label for="skill_communications" class="form-check-label">Communications</label>
                </div>
                <div class="form-check">
                    <input type="checkbox" id="skill_construction" asp-for="SelectedSkills" value="Construction" class="form-check-input" />
                    <label for="skill_construction" class="form-check-label">Construction</label>
                </div>
                <div class="form-check">
                    <input type="checkbox" id="skill_counselling" asp-for="SelectedSkills" value="Counselling" class="form-check-input" />
                    <label for="skill_counselling" class="form-check-label">Counselling</label>
                </div>
                <div class="form-check">
                    <input type="checkbox" id="skill_administration" asp-for="SelectedSkills" value="Administration" class="form-check-input" />
                    <label for="skill_administration" class="form-check-label">Administration</label>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label" for="Skills">Other Skills or Experience *</label>
                <textarea class="form-control" id="Skills" name="Skills" rows="4"
                          placeholder="Describe any other relevant skills, certifications, or experience (e.g., First Aid, Heavy Equipment Operation, etc.)"
                          asp-for="Skills"></textarea>
                <span asp-validation-for="Skills" class="invalid-feedback"></span>
            </div>
        </div>

        <!-- Availability -->
        <div class="form-section">
            <div class="form-section-title">Availability</div>

            <p class="form-help-text">How often can you volunteer? *</p>

            <div class="availability-options">
                <div class="form-check">
                    <input type="radio" id="avail_fulltime" name="Availability" value="Full-time"
                           asp-for="Availability" class="form-check-input" />
                    <label for="avail_fulltime" class="form-check-label">Full-time</label>
                </div>
                <div class="form-check">
                    <input type="radio" id="avail_parttime" name="Availability" value="Part-time"
                           asp-for="Availability" class="form-check-input" />
                    <label for="avail_parttime" class="form-check-label">Part-time</label>
                </div>
                <div class="form-check">
                    <input type="radio" id="avail_weekends" name="Availability" value="Weekends only"
                           asp-for="Availability" class="form-check-input" />
                    <label for="avail_weekends" class="form-check-label">Weekends only</label>
                </div>
                <div class="form-check">
                    <input type="radio" id="avail_occasional" name="Availability" value="Occasional"
                           asp-for="Availability" class="form-check-input" />
                    <label for="avail_occasional" class="form-check-label">Occasional</label>
                </div>
            </div>

            <span asp-validation-for="Availability" class="invalid-feedback"></span>
        </div>

        <!-- Submit -->
        <div class="submit-section">
            <button type="submit" class="btn btn-primary btn-large">Submit Application</button>
        </div>
        </form>
    </div>
</main>
</div>

<div style="margin-bottom: 3rem;"></div>

<partial name="Shared/_Footer" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
